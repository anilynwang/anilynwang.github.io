---
import type { Language } from '@/i18n/config'
import { getPostPath } from '@/i18n/path'
import { getPosts } from '@/utils/content'
import { getPostDescription } from '@/utils/description'

interface Props { lang: Language, newspaper?: boolean }
const { lang, newspaper = false } = Astro.props
const posts = await getPosts(lang)
const authors = [...new Set(posts.map(p => p.data.author || '未署名'))].sort()
const genres = [...new Set(posts.map(p => p.data.genre || '未分类'))].sort()
const tags = [...new Set(posts.flatMap(p => p.data.tags))].sort()
---
<section class:list={['article-explorer', { newspaper }]} data-explorer>
  <header class="edition-heading">
    <div><p class="edition-kicker">野秋鹿 · 文学与生活</p><h1>{newspaper ? '落纸之间' : '作品索引'}</h1></div>
    <p class="edition-note">{newspaper ? '写下所见，留住所感。' : '按署名、文体、标签与日期，寻找一篇文字。'}<br />共 {posts.length} 篇文字</p>
  </header>
  <form class="explorer-tools" role="search" onsubmit="return false">
    <label class="explorer-search">搜索文章<input type="search" name="query" placeholder="标题、正文、署名…" autocomplete="off" /></label>
    <label>署名<select name="author"><option value="">全部署名</option>{authors.map(a => <option value={a}>{a}</option>)}</select></label>
    <label>文体<select name="genre"><option value="">全部文体</option>{genres.map(g => <option value={g}>{g}</option>)}</select></label>
    <label>标签<select name="tag"><option value="">全部标签</option>{tags.map(t => <option value={t}>{t}</option>)}</select></label>
    <button type="button" data-calendar-toggle aria-expanded="false" aria-controls="article-calendar">按日历查阅</button>
    <button type="reset">重置</button>
  </form>
  <div id="article-calendar" class="article-calendar" hidden>
    <div class="calendar-toolbar"><button type="button" data-prev aria-label="上个月">←</button><label>查阅月份<input type="month" data-month /></label><button type="button" data-next aria-label="下个月">→</button><button type="button" data-clear-date>全部日期</button></div>
    <p class="calendar-help">带圆点的日期有文章，点击日期筛选。</p>
    <div class="calendar-week" aria-hidden="true">{['一', '二', '三', '四', '五', '六', '日'].map(d => <span>{d}</span>)}</div>
    <div class="calendar-days" data-days></div>
  </div>
  <p class="explorer-status" role="status" aria-live="polite" data-status>全部作品 · {posts.length} 篇</p>
  <div class="newspaper-grid">
    {posts.map((post, i) => {
      const date = post.data.published.toISOString().slice(0, 10)
      const author = post.data.author || '未署名'
      const genre = post.data.genre || '未分类'
      return (
<article class="paper-story" data-story data-date={date} data-author={author} data-genre={genre} data-tags={JSON.stringify(post.data.tags)} data-search={[post.data.title, author, genre, ...post.data.tags, post.body || ''].join(' ').toLocaleLowerCase()}>
        <div class="story-section"><span>{genre}</span><span>{String(i + 1).padStart(2, '0')}</span></div>
        <h2><a href={getPostPath(post.data.abbrlink || post.id, lang)}>{post.data.title}</a></h2>
        <p class="story-byline">{author} <span>／</span> <time datetime={date}>{date}</time></p>
        <p class="story-excerpt">{getPostDescription(post, 'list')}</p>
        <a class="story-read" href={getPostPath(post.data.abbrlink || post.id, lang)}>阅读全文 <span aria-hidden="true">↗</span></a>
      </article>
)
    })}
  </div>
  <p class="explorer-empty" data-empty hidden>没有找到符合条件的文章。试试其他关键词，或重置筛选。</p>
</section>
<script>
function setupExplorers() {
  document.querySelectorAll<HTMLElement>('[data-explorer]').forEach((root) => {
    if (root.dataset.ready)
      return
    root.dataset.ready = 'true'
    const form = root.querySelector<HTMLFormElement>('form')!
    const stories = [...root.querySelectorAll<HTMLElement>('[data-story]')]
    const calendar = root.querySelector<HTMLElement>('.article-calendar')!
    const toggle = root.querySelector<HTMLButtonElement>('[data-calendar-toggle]')!
    const month = root.querySelector<HTMLInputElement>('[data-month]')!
    const days = root.querySelector<HTMLElement>('[data-days]')!
    let selectedDate = ''
    month.value = stories[0]?.dataset.date?.slice(0, 7) || new Date().toISOString().slice(0, 7)
    const control = (name: string) => form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement
    function apply() {
      const terms = control('query').value.trim().toLocaleLowerCase().split(/\s+/).filter(Boolean)
      let count = 0
      for (const story of stories) {
        const matches = terms.every(t => story.dataset.search!.includes(t))
          && (!control('author').value || story.dataset.author === control('author').value)
          && (!control('genre').value || story.dataset.genre === control('genre').value)
          && (!control('tag').value || JSON.parse(story.dataset.tags!).includes(control('tag').value))
          && (!selectedDate || story.dataset.date === selectedDate)
        story.hidden = !matches
        if (matches)
          count++
      }
      root.querySelector('[data-status]')!.textContent = `${selectedDate || '全部日期'} · 找到 ${count} 篇文字`
      root.querySelector<HTMLElement>('[data-empty]')!.hidden = count > 0
    }
    function drawCalendar() {
      days.replaceChildren()
      const [year, m] = month.value.split('-').map(Number)
      if (!year || !m)
        return
      const offset = (new Date(year, m - 1, 1).getDay() + 6) % 7
      for (let i = 0; i < offset; i++) days.append(document.createElement('span'))
      for (let d = 1; d <= new Date(year, m, 0).getDate(); d++) {
        const date = `${month.value}-${String(d).padStart(2, '0')}`
        const count = stories.filter(s => s.dataset.date === date).length
        const button = document.createElement('button')
        button.type = 'button'
        button.textContent = String(d)
        button.disabled = count === 0
        button.classList.toggle('has-stories', count > 0)
        button.setAttribute('aria-label', `${date}，${count} 篇文章`)
        button.setAttribute('aria-pressed', String(selectedDate === date))
        button.addEventListener('click', () => {
          selectedDate = selectedDate === date ? '' : date
          drawCalendar()
          apply()
        })
        days.append(button)
      }
    }
    toggle.addEventListener('click', () => {
      calendar.hidden = !calendar.hidden
      toggle.setAttribute('aria-expanded', String(!calendar.hidden))
    })
    form.addEventListener('input', apply)
    form.addEventListener('reset', () => {
      selectedDate = ''
      setTimeout(() => {
        drawCalendar()
        apply()
      }, 0)
    })
    month.addEventListener('change', drawCalendar)
    root.querySelector('[data-clear-date]')!.addEventListener('click', () => {
      selectedDate = ''
      drawCalendar()
      apply()
    })
    for (const [selector, delta] of [['[data-prev]', -1], ['[data-next]', 1]] as const) {
      root.querySelector(selector)!.addEventListener('click', () => {
        const [y, m] = month.value.split('-').map(Number)
        const next = new Date(y, m - 1 + delta, 1)
        month.value = `${next.getFullYear()}-${String(next.getMonth() + 1).padStart(2, '0')}`
        drawCalendar()
      })
    }
    drawCalendar()
  })
}
setupExplorers()
document.addEventListener('astro:page-load', setupExplorers)
</script>
